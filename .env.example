# excel-mcp server configuration
# Copy to .env and adjust for your deployment.

# --- Server binding ---
# MCP_HOST: bind address (default 0.0.0.0; use 127.0.0.1 to restrict to localhost)
MCP_HOST=0.0.0.0
# MCP_PORT: listen port (default 8080)
MCP_PORT=8080
# RUST_LOG: tracing filter (default info; e.g. debug to see S3 request detail)
RUST_LOG=info

# --- Authentication ---
# MCP_AUTH_KEY: pre-shared key(s) for Bearer-token auth on /mcp. Leave empty to
# disable auth (not recommended for anything reachable outside localhost).
# Multiple keys can be comma-separated, e.g. agent1-key,agent2-key
MCP_AUTH_KEY=change-me

# --- S3 (REQUIRED; all tool IO — reads and writes — goes through S3) ---
# Without S3_BUCKET + credentials every tool call fails with "not configured".
# S3_BUCKET: bucket workbooks are read from and written to
S3_BUCKET=uploads
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY: credentials for the bucket
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_ENDPOINT_URL: custom endpoint for MinIO/R2, e.g.
# http://minio.<namespace>.svc.cluster.local:9000 (empty = real AWS S3)
AWS_ENDPOINT_URL=
# S3_REGION: region (default us-east-1; falls back to AWS_REGION)
S3_REGION=us-east-1
# S3_USE_PATH_STYLE: true/false; unset = path-style iff AWS_ENDPOINT_URL is set
S3_USE_PATH_STYLE=true
# S3_KEY_PREFIXES: comma-segment key-prefix allowlist constraining BOTH
# readable inputs and writable outputs (e.g. "workspaces/"). Empty = no
# restriction: only safe when every MCP_AUTH_KEY holder may read and
# write the whole bucket.
S3_KEY_PREFIXES=

# --- excel-mcp knobs ---
# EXCEL_INLINE_MAX_BYTES: responses inline the workbook base64 when at or below
# this size (default 2097152 = 2 MiB)
EXCEL_INLINE_MAX_BYTES=2097152
# EXCEL_MAX_FILE_BYTES: upload/download size cap (default 104857600 = 100 MiB)
EXCEL_MAX_FILE_BYTES=104857600
